<mujoco model="bsra_cartpole">
  <!-- MEMBER TODO 2.3: Set compiler angle units and simulation options.
       Disable geom collisions with a default shared by model and scenery. -->
  <compiler angle="degree" coordinate="local" inertiafromgeom="true" settotalmass="true" collision="disable"/>
  <option gravity="0 0 -9.81" integrator="RK4" timestep="0.02"/>
  <default>
    <geom contype="0" conaffinity="0"/>
  </default>
  <!-- MEMBER TODO 2.4: Include cartpole.xml here. -->
  <include file="cartpole.xml"/>
  <worldbody>
    <!-- MEMBER TODO 2.5: Add a floor, rail, light, and camera named side.
         Choose a view showing the full rail and upright pole. -->
         <!-- Floor -->
         <geom name="floor"
              type="plane"
              pos="0 0 0"
              size="3 2 0.1"
              rgba="0.7 0.7 0.7 1"/>

        <!-- Rail -->
        <geom name="rail"
              type="box"
              pos="0 0 0.08"
              size="1.5 0.04 0.04"
              rgba="0.3 0.3 0.3 1"/>

        <!-- Light -->
        <light name="light"
               pos="0 0 3"
               dir="0 0 -1"
               diffuse="0.8 0.8 0.8"/>

        <!-- Side camera -->
        <camera name="side"
                pos="0 -3 1"
                xyaxes="1 0 0 0 0 1"/>

  </worldbody>
</mujoco>
